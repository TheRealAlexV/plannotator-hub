# Plan Hub workstation agent configuration.
#
# Install as /etc/planhub-agent.env on each workstation, owned by the user that
# runs the systemd --user service (mode 600). See systemd/planhub-agent.service
# and workstation/planhub-agent.py.
#
# The agent refuses to start unless PLANHUB_AGENT_TOKEN is set.

# Shared secret the hub must present as the X-Planhub-Token header (fail-closed).
# Generate one per host, e.g.:  openssl rand -hex 16
PLANHUB_AGENT_TOKEN=

# Listen address/port (the hub dials this host:port).
PLANHUB_AGENT_BIND=0.0.0.0
PLANHUB_AGENT_PORT=8898

# This host's LAN IP, published to the reviewer as PLANNOTATOR_URL_HOST.
PLANHUB_URL_HOST=10.0.0.10

# This host's DISJOINT Plannotator port slice, passed through as
# PLANNOTATOR_PORT (a range, e.g. 19432-19463). Slices must not overlap.
PLANHUB_PORT_RANGE=19432-19463

# Path to the plannotator binary.
PLANHUB_BIN=/home/user/.local/bin/plannotator

# Optional: command to hand a plan to an implementation agent. "{plan}" is
# replaced with the absolute plan path and "{project}" with the requested
# project directory. When unset, /api/agent/apply returns 400. Example:
#   PLANHUB_APPLY_COMMAND=opencode run --agent build "Implement the plan at {plan}"
PLANHUB_APPLY_COMMAND=

# Optional: state directory (default ~/.planhub).
# PLANHUB_HOME=/home/user/.planhub
