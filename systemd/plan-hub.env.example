# Plannotator plan hub configuration.
#
# Install as /etc/plan-hub.env (see install.sh and docs/architecture.md).
# Every value below is also a code default in hub/plan-hub.py; the values
# here are generic examples, not a working deployment.

# Workstations to scan for live Plannotator sessions: host:portStart-portEnd,
# comma-separated. Each workstation owns a DISJOINT port range because live
# session URLs are derived from the port (https://p<port>.<suffix>/).
HUB_WORKSTATIONS=10.0.0.10:19432-19463,10.0.0.11:19464-19495

# Read-only plan archive servers, one host:port per workstation
# (the `plannotator archive` listener on each workstation).
HUB_ARCHIVES=10.0.0.10:8897,10.0.0.11:8897

# Friendly display names: host=label, comma-separated.
HUB_LABELS=10.0.0.10=workstation-a,10.0.0.11=workstation-b

# Public DNS suffix used to build per-session links.
HUB_PUBLIC_SUFFIX=plan.example.com

# Interface and port the hub itself listens on (front it with TLS + SSO).
HUB_BIND=127.0.0.1
HUB_PORT=8899

# Absolute paths to the page files installed alongside plan-hub.py.
HUB_PLAN_PAGE=/opt/plan-hub/plans-page.html
HUB_SESSIONS_PAGE=/opt/plan-hub/sessions-page.html

# Optional tuning knobs (defaults shown):
# HUB_INTERVAL=3            # seconds between workstation scans
# HUB_PROBE_TIMEOUT=2       # per-probe timeout, seconds
# HUB_GRACE=10              # seconds a disappeared session is still shown
# HUB_ARCHIVE_TIMEOUT=6     # archive fetch timeout, seconds
# HUB_ARCHIVE_CACHE=20      # archive index cache lifetime, seconds
